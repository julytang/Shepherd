    { "name": "Release", "file": "Shared.xcconfig" },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "kind": "folder", "path": "Shepherd", "target-membership": [ "macOS" ] },
    { "path": "../../Config/Shared.xcconfig" },
