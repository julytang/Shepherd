    { "kind": "local", "path": "../../Packages/ShepherdUI" },
  ],
  "targets": [
    {
      "name": "macOS",
      "id": "E91A83D130B98B05005436F2",
      "product": "Products/Shepherd.app",
      "product-type": "application",
      "dependencies": [
        "Reaper",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Helpers",
          "bundle-base-path": "contents-directory",
          "relative-path": "Helpers",
        },
      ],
      "package-product-members": [
        { "product-name": "ShepherdCore", "build-phase": { "build-phase": "frameworks" } },
        { "product-name": "ShepherdGit", "build-phase": { "build-phase": "frameworks" } },
        { "product-name": "ShepherdModels", "build-phase": { "build-phase": "frameworks" } },
        { "product-name": "ShepherdProviderACP", "build-phase": { "build-phase": "frameworks" } },
        { "product-name": "ShepherdProviderClaude", "build-phase": { "build-phase": "frameworks" } },
        { "product-name": "ShepherdProviderCodex", "build-phase": { "build-phase": "frameworks" } },
        { "product-name": "ShepherdProviderKit", "build-phase": { "build-phase": "frameworks" } },
        { "product-name": "ShepherdRemote", "build-phase": { "build-phase": "frameworks" } },
        { "product-name": "ShepherdStorage", "build-phase": { "build-phase": "frameworks" } },
        { "product-name": "ShepherdUI", "build-phase": { "build-phase": "frameworks" } },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "ENABLE_APP_SANDBOX": "NO",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SELECTED_FILES": "readonly",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "$(SHEPHERD_APP_BUNDLE_ID)",
        "PRODUCT_NAME": "Shepherd",
        "REGISTER_APP_GROUPS": "YES",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
      },
    }, {
      "name": "macOSTests",
      "id": "E91A83DE30B98B05005436F2",
      "product": "Products/macOSTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "macOS",
      "dependencies": [
        "macOS",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_STYLE": "Automatic",
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "$(SHEPHERD_APP_BUNDLE_ID).tests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "STRING_CATALOG_GENERATE_SYMBOLS": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/Shepherd.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/Shepherd",
      },
    }, {
      "name": "macOSUITests",
      "id": "E91A83E830B98B05005436F2",
      "product": "Products/macOSUITests.xctest",
      "product-type": "bundle.ui-testing",
      "test-host-target": "macOS",
      "dependencies": [
