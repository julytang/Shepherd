    { "kind": "folder", "path": "Reaper", "target-membership": [ "Reaper" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Shepherd.app", "id": "E91A83D230B98B05005436F2", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/macOSTests.xctest", "id": "E91A83DF30B98B05005436F2", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/macOSUITests.xctest", "id": "E91A83E930B98B05005436F2", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/shepherd-reaper", "id": "E91A842830B98B76005436F2", "type": "compiled.mach-o.executable", "index": false, "target-membership": [ "macOS/copy/Embed Helpers" ] },
      ],
    },
  ],
  "packages": [
    { "kind": "local", "path": "../../Packages/ShepherdCore" },
    { "kind": "local", "path": "../../Packages/ShepherdGit" },
    { "kind": "local", "path": "../../Packages/ShepherdModels" },
    { "kind": "local", "path": "../../Packages/ShepherdProviderACP" },
    { "kind": "local", "path": "../../Packages/ShepherdProviderClaude" },
    { "kind": "local", "path": "../../Packages/ShepherdProviderCodex" },
    { "kind": "local", "path": "../../Packages/ShepherdProviderKit" },
